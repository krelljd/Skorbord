@page "/score/{BoardSqid}"
@layout BasicLayout
@rendermode @(new InteractiveServerRenderMode(false))
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using Sqids
@using Skorbord.Data
@inject NavigationManager Navigation
@inject SqidsEncoder<int> sqids
@inject IDbContextFactory<Skorbord.Data.ScoreboardContext> DbFactory
@inject ILogger<Score> Logger
@implements IAsyncDisposable

<PageTitle>Skorbord.app</PageTitle>
<FluentDesignTheme Mode="DesignThemeModes.Light" CustomColor="#557086" />

<div class="score-content">
	<FluentStack Orientation="Orientation.Horizontal" Wrap="true">
		@team1
		<FluentStack Orientation="Orientation.Horizontal" Wrap="false">
			<FluentButton IconStart="@(new Icons.Regular.Size48.ArrowCircleDown())"
						  OnClick="@(() => UpdateScore((int)activeSet, -1))" Disabled="@(!IsConnected)"
						  Appearance="Appearance.Neutral" Class="score-button" Loading="@buttonLoading">
				@_scores[(int)activeSet]
			</FluentButton>
			<FluentButton IconStart="@(new Icons.Regular.Size48.ArrowCircleUp())"
						  OnClick="@(() => UpdateScore((int)activeSet, 1))" Disabled="@(!IsConnected)"
						  Appearance="Appearance.Accent" Class="score-button" Loading="@buttonLoading">
				@_scores[(int)activeSet]
			</FluentButton>
		</FluentStack>
		@team2
		<FluentStack Orientation="Orientation.Horizontal" Wrap="false">
			<FluentButton IconStart="@(new Icons.Regular.Size48.ArrowCircleDown())"
						  OnClick="@(() => UpdateScore((int)activeSet + 1, -1))" Disabled="@(!IsConnected)"
						  Appearance="Appearance.Neutral" Class="score-button" Loading="@buttonLoading">
				@_scores[(int)activeSet + 1]
			</FluentButton>
			<FluentButton IconStart="@(new Icons.Regular.Size48.ArrowCircleUp())"
						  OnClick="@(() => UpdateScore((int)activeSet + 1, 1))" Disabled="@(!IsConnected)"
						  Appearance="Appearance.Accent" Class="score-button" Loading="@buttonLoading">
				@_scores[(int)activeSet + 1]
			</FluentButton>
		</FluentStack>
	</FluentStack>
	<br>
	Active Set
	<FluentStack Orientation="Orientation.Horizontal" Wrap="false">
		<FluentButton IconStart="@(new Icons.Regular.Size32.Flag())"
					  OnClick="@(e => ActiveSetClicked(SetOptions.Set1))" Disabled="@(!IsConnected)"
					  Appearance="@(activeSet == SetOptions.Set1 ? Appearance.Accent : Appearance.Neutral)" 
					  Class="set-button" Loading="@buttonLoading">Set 1
		</FluentButton>
		<FluentButton IconStart="@(new Icons.Regular.Size32.Flag())"
					  OnClick="@(() => ActiveSetClicked(SetOptions.Set2))" Disabled="@(!IsConnected)"
					  Appearance="@(activeSet == SetOptions.Set2 ? Appearance.Accent : Appearance.Neutral)"
					  Class="set-button" Loading="@buttonLoading">Set 2
		</FluentButton>
		<FluentButton IconStart="@(new Icons.Regular.Size32.FlagClock())"
					  OnClick="@(() => ActiveSetClicked(SetOptions.Set3))" Disabled="@(!IsConnected)"
					  Appearance="@(activeSet == SetOptions.Set3 ? Appearance.Accent : Appearance.Stealth)"
					  Class="set-button" Loading="@buttonLoading">Set 3
		</FluentButton>
	</FluentStack>
	<br />
	<FluentStack Orientation="Orientation.Horizontal" Wrap="false">
		<FluentButton IconStart="@(new Icons.Regular.Size24.DismissSquare())"
					  OnClick="@(() => ResetSetScores((int)activeSet))" Disabled="@(!IsConnected)" BackgroundColor="var(--error)"
					  Appearance="Appearance.Accent" Loading="@buttonLoading" Class="reset-scores-button">
			Reset @activeSet Scores
		</FluentButton>
		<FluentButton IconStart="@(new Icons.Regular.Size24.DismissSquare())" OnClick="@(() => ResetAllScores())"
					  Disabled="@(!IsConnected)" BackgroundColor="var(--error)" Appearance="Appearance.Accent"
					  Loading="@buttonLoading" Class="reset-scores-button">
			Reset Match Scores
		</FluentButton>
	</FluentStack>
	<hr>
	Administration
	<FluentStack Orientation="Orientation.Horizontal">
		<FluentTextField @bind-Value="@team1" Class="team-name-input" Placeholder="Team 1 Name" AutoComplete="off">
		</FluentTextField>
		<ColorSelector CurrentColor="@team1Color" ReturnedColor="Team1ColorChanged" Style="width: 20vw;">
		</ColorSelector>
	</FluentStack>
	<FluentStack Orientation="Orientation.Horizontal">
		<FluentTextField @ref="team2Field" @bind-Value="@team2" Class="team-name-input" Placeholder="Team 2 Name" AutoComplete="off" Autocapitalize="on">
			<FluentIcon Slot="end" Icon="Icons.Regular.Size24.DismissSquare" OnClick="@(() => ClearAndFocusTeam2())"></FluentIcon>
		</FluentTextField>
		<ColorSelector CurrentColor="@team2Color" ReturnedColor="Team2ColorChanged" Style="width: 20vw;">
		</ColorSelector>
	</FluentStack>
	<FluentStack Orientation="Orientation.Horizontal">
		<FluentTextField @bind-Value="@tournament" Class="team-name-input" Placeholder="Tournament Name"
						 AutoComplete="off"></FluentTextField>
		<ColorSelector CurrentColor="@scoreboardColor" ReturnedColor="BoardColorChanged" Style="width: 20vw;">
		</ColorSelector>
	</FluentStack>
	<br>
	<FluentButton IconStart="@(new Icons.Regular.Size24.Save())" OnClick="@(SaveMatchInfoClicked)"
				  Disabled="@(!IsConnected)" Appearance="Appearance.Accent" Loading="@buttonLoading" Class="save-button">
		Save Match Info
	</FluentButton>
	<br>
	<hr>
	<FluentAccordion>
		<FluentAccordionItem Heading="Advanced Settings" HeadingLevel="1">
			<FluentLabel Alignment="HorizontalAlignment.Center">
				Board: <a href="@boardUri" target="_blank">@boardUri</a>
			</FluentLabel>
			<br>
			<FluentIcon Value="@(new Icons.Regular.Size20.Edit())" Color="@Color.Neutral" Slot="start" />
			<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
				<input class="score-input" Size="2" @bind="@_scores[0]"></input>
				<input class="score-input" Size="2" @bind="@_scores[2]"></input>
				<input class="score-input" Size="2" @bind="@_scores[4]"></input>
			</FluentStack>
			<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
				<input class="score-input" Size="2" @bind="@_scores[1]"></input>
				<input class="score-input" Size="2" @bind="@_scores[3]"></input>
				<input class="score-input" Size="2" @bind="@_scores[5]"></input>
			</FluentStack>
			<br>
			<FluentButton IconStart="@(new Icons.Regular.Size24.Save())" OnClick="@(PublishScores)"
						  Disabled="@(!IsConnected)" Appearance="Appearance.Accent" Class="save-button" Loading="@buttonLoading">
				Save Scores
			</FluentButton>
		</FluentAccordionItem>
	</FluentAccordion>
	<br>
	<br>
</div>

@code {
	private HubConnection? hubConnection;
	private List<string> messages = new List<string>();
	public string team1 = "";
	public string team2 = "";
	public string team1Color = "";
	public string team2Color = "";
	public string scoreboardColor = "";
	public string tournament = "";
	private int[] _scores = new int[] { 0, 0, 0, 0, 0, 0 };
	private int boardId;
	private SetOptions activeSet = SetOptions.Set1;
	private string boardUri = "#";
	private bool buttonLoading = false;
	private FluentTextField? team2Field;
	private Timer? _debounceTimer;
	private const int DEBOUNCE_INTERVAL = 500; // in ms
	private const int CACHE_DURATION = 1; // in seconds
	private DateTime _lastCacheUpdate = DateTime.MinValue;
	private bool _isInitialLoad = true;

	[Parameter]
	public string? BoardSqid { get; set; }

	private async Task<Scoreboard?> GetCachedScoreboard()
	{
		if (!_isInitialLoad && DateTime.UtcNow.Subtract(_lastCacheUpdate).TotalSeconds < CACHE_DURATION)
		{
			return new Scoreboard
			{
				ScoreboardId = boardId,
				TeamName1 = team1,
				TeamName2 = team2,
				TeamColor1 = team1Color,
				TeamColor2 = team2Color,
				Tournament = tournament,
				BoardColor = scoreboardColor,
				ActiveSet = (int)activeSet,
				Scores = new ScoreArray(_scores).ToString()
			};
		}

		using var context = DbFactory.CreateDbContext();
		if (context.Scoreboards != null)
		{
			var scoreboard = await context.Scoreboards.AsNoTracking()
				.FirstAsync<Scoreboard>(s => s.ScoreboardId == boardId);
			
			_isInitialLoad = false;
			_lastCacheUpdate = DateTime.UtcNow;
			return scoreboard;
		}
		return null;
	}

	protected override async Task OnInitializedAsync()
	{
		var hubUrl = "https://skorbord.app/scorehub";
		//var hubUrl = "http://localhost:8000/scorehub";

		hubConnection = new HubConnectionBuilder()
		.WithUrl(hubUrl)
		.ConfigureLogging(logging =>
		{
			logging.AddConsole();
			logging.SetMinimumLevel(LogLevel.Debug);
		})
		.WithAutomaticReconnect()
		.Build();

		// decode sqid
		boardId = getBoardIdFromSqid(BoardSqid!);
		var boardSqid = sqids.Encode(boardId);
		boardUri = "/board/" + @boardSqid;

		if (boardId > 0)
		{
			var scoreboard = await GetCachedScoreboard();
			if (scoreboard != null)
			{
				// Batch state updates
				await InvokeAsync(() =>
				{
					team1 = scoreboard.TeamName1;
					team2 = scoreboard.TeamName2;
					team1Color = scoreboard.TeamColor1;
					team2Color = scoreboard.TeamColor2;
					tournament = scoreboard.Tournament.ToUpperInvariant();
					scoreboardColor = scoreboard.BoardColor;
					activeSet = (SetOptions)scoreboard.ActiveSet;
					_scores = new ScoreArray(scoreboard.Scores).Scores;
				});

				// Optimize event handlers to reduce renders
				hubConnection.On<int, int[]>("UpdateScores", async (bId, scores) =>
				{
					if (bId == boardId)
					{
						_scores = scores;
						_lastCacheUpdate = DateTime.UtcNow;
						await InvokeAsync(StateHasChanged);
					}
				});

				hubConnection.On<int, string, string, string, string>("UpdateTeamInfo",
				async (bId, t1, t1c, t2, t2c) =>
				{
					if (bId == boardId)
					{
						team1 = t1;
						team2 = t2;
						team1Color = t1c;
						team2Color = t2c;
						_lastCacheUpdate = DateTime.UtcNow;
						await InvokeAsync(StateHasChanged);
					}
				});

				hubConnection.On<int, string, string>("UpdateDisplay",
				async (bId, trn, bc) =>
				{
					if (bId == boardId)
					{
						tournament = trn.ToUpperInvariant();
						scoreboardColor = bc;
						_lastCacheUpdate = DateTime.UtcNow;
						await InvokeAsync(StateHasChanged);
					}
				});

				hubConnection.On<int, int>("UpdateActiveSet",
				async (bId, set) =>
				{
					if (bId == boardId)
					{
						activeSet = (SetOptions)set;
						_lastCacheUpdate = DateTime.UtcNow;
						await InvokeAsync(StateHasChanged);
					}
				});

				await hubConnection.StartAsync();
			}
		}
	}

	private async Task PublishScores()
	{
		if (hubConnection is not null)
		{
			await hubConnection.SendAsync("SendScoresMessage", boardId, _scores);
		}
	}

	private async Task PublishTeamInfo()
	{
		if (hubConnection is not null)
		{
			await hubConnection.SendAsync("SendTeamInfoMessage", boardId, team1, team1Color, team2, team2Color);
		}
	}
	private async Task PublishDisplayInfo()
	{
		if (hubConnection is not null)
		{
			await hubConnection.SendAsync("SendDisplayMessage", boardId, tournament.ToUpperInvariant(), scoreboardColor);
		}
	}
	private async Task PublishActiveSetInfo()
	{
		if (hubConnection is not null)
		{
			await hubConnection.SendAsync("SendActiveSetMessage", boardId, (int)activeSet);
		}
	}

	private async Task UpdateScore(int index, int valueUpDown)
	{
		_scores[index] = _scores[index] + valueUpDown;
		await PublishScores(); // Immediately publish to other clients
		await DebounceSaveScoreChanges();
	}

	private async Task DebounceSaveScoreChanges()
	{
		_debounceTimer?.Dispose();
		_debounceTimer = new Timer(async _ =>
		{
			await SaveScoreChanges();
		}, null, DEBOUNCE_INTERVAL, Timeout.Infinite);
	}

	private async Task ResetSetScores(int index)
	{
		_scores[index] = 0;
		_scores[index + 1] = 0;
		await PublishScores(); // Immediately publish to other clients
		await SaveScoreChanges();
	}

	private async Task ResetAllScores()
	{
		_scores = new int[] { 0, 0, 0, 0, 0, 0 };
		await PublishScores(); // Immediately publish to other clients
		await SaveScoreChanges();
	}

	private void Team1ColorChanged(string e)
	{
		team1Color = e;
	}

	private void Team2ColorChanged(string e)
	{
		team2Color = e;
	}

	private void BoardColorChanged(string e)
	{
		scoreboardColor = e;
	}

	private async void ActiveSetClicked(SetOptions set)
	{
		buttonLoading = true;
		activeSet = set;
		await SaveActiveSet(set);
		await PublishActiveSetInfo();
		buttonLoading = false;
	}

	private async Task ClearAndFocusTeam2()
	{
		team2 = string.Empty;
		if (team2Field is not null)
		{
			await team2Field.FocusAsync();
		}
	}

	private async Task SaveMatchInfoClicked()
	{
		buttonLoading = true;
		await SaveBoardInfo();
		await PublishDisplayInfo();
		await PublishTeamInfo();
		buttonLoading = false;
	}

	private async Task SaveScoreChanges()
	{
		if (buttonLoading) return; // Prevent concurrent saves
		
		buttonLoading = true;
		try
		{
			using var context = DbFactory.CreateDbContext();

			if (context.Scoreboards != null)
			{
				var scoreboard = await context.Scoreboards
				.FirstAsync<Scoreboard>(s => s.ScoreboardId == boardId);

				scoreboard.Scores = new ScoreArray(_scores).ToString();
				await context.SaveChangesAsync();
				_lastCacheUpdate = DateTime.UtcNow;
			}
		}
		finally
		{
			buttonLoading = false;
		}
	}

	private async Task SaveBoardInfo()
	{
		buttonLoading = true;
		try
		{
			using var context = DbFactory.CreateDbContext();

			if (context.Scoreboards != null)
			{
				var scoreboard = await context.Scoreboards
				.FirstAsync<Scoreboard>(s => s.ScoreboardId == boardId);

				scoreboard.TeamName1 = team1;
				scoreboard.TeamName2 = team2;
				scoreboard.TeamColor1 = team1Color;
				scoreboard.TeamColor2 = team2Color;
				scoreboard.Tournament = tournament.ToString().ToUpperInvariant();
				scoreboard.BoardColor = scoreboardColor;

				await context.SaveChangesAsync();
				_lastCacheUpdate = DateTime.UtcNow;
			}
		}
		finally
		{
			buttonLoading = false;
		}
		await InvokeAsync(StateHasChanged);
	}

	private async Task SaveActiveSet(SetOptions set)
	{
		using var context = DbFactory.CreateDbContext();

		if (context.Scoreboards != null)
		{
			var scoreboard = await context.Scoreboards
			.FirstAsync<Scoreboard>(s => s.ScoreboardId == boardId);

			scoreboard.ActiveSet = (int)set;
			await context.SaveChangesAsync();
			_lastCacheUpdate = DateTime.UtcNow;
		}
		await InvokeAsync(StateHasChanged);
	}

	private int getBoardIdFromSqid(string sqid)
	{
		if (sqids.Decode(sqid) is [var decodedId] && sqid == sqids.Encode(decodedId))
		{
			// `sqid` decodes into a single number and is canonical, here you can safely proceed with the rest of the logic
			return 1;
		}
		else
		{
			// consider `sqid` invalid — e.g. respond with 404
			return 0;
		}
	}

	public bool IsConnected =>
	hubConnection?.State == HubConnectionState.Connected;

	public async ValueTask DisposeAsync()
	{
		_debounceTimer?.Dispose();
		if (hubConnection is not null)
		{
			await hubConnection.DisposeAsync();
		}
	}
}